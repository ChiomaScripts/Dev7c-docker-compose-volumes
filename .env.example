# Replica of my .env.docker
# If cloning my repo, replace placeholders; don't commit .env.docker.
# MongoDB password should be consistent in all three URLs/credentials.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_DB_PASSWORD
MONGO_URI=mongodb://admin:CHANGE_ME_DB_PASSWORD@mongodb:27017/user-account?authSource=admin
MONGO_DB_NAME=user-account
MONGO_COLLECTION_NAME=users
ME_CONFIG_MONGODB_URL=mongodb://admin:CHANGE_ME_DB_PASSWORD@mongodb:27017/?authSource=admin
ME_CONFIG_BASICAUTH_USERNAME=user
ME_CONFIG_BASICAUTH_PASSWORD=CHANGE_ME_UI_PASSWORD